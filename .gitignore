# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / Python venv (this dir was originally a PyCharm Python project)
/.idea/
/.venv/

# Claude Code local permissions and runtime state
/.claude/settings.local.json
/.claude/scheduled_tasks.*

# Internal artefacts (kept out of source control)
/briefing-extracted.txt
/qa-transcript-*.json
.gstack/

# Playwright e2e — keep test sources, ignore artefacts
/tests/e2e/results/
/playwright-report/
/test-results/

.vercel
.env*.local

# Supabase CLI runtime state (linked-project ref, version cache, etc.)
/supabase/.temp/
/supabase/.branches/
/supabase/.env
tmp/

.env.lingopure.tmp

# Naive-tester QA artefacts (screenshots + reports, incl. other-product passes) — machine-local
/naive-tester-reports/

# Claude Code local session stub — uncustomised template; health-sensors.yml explicitly
# excludes the session smoke until a real one is wired. Contains test creds.
/session.config.json

# One-off ops script — provisions a named demo admin with a temp password; not app code
/scripts/setup-daniel-admin.ts

# Investor dataroom SOURCE FILES — confidential (NDAs, contracts, cap table, board IC).
# These live ONLY in the private Supabase 'dataroom' bucket behind the NDA/tier gate — never in git.
/docs/LingoPure main documents/
/docs/LP Deep Dive Documents/
